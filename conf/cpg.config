/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    CPG: Google Batch, as launched by analysis-runner through Seqera
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included at the end of nextflow.config whenever params.arGuid is set, i.e. every
    analysis-runner launch, and after conf/modules.config so the resources here win.
    The launcher supplies -work-dir and google.project. See docs/CPG_METAMIST_SEQR_DESIGN.md (T5.1).

    Resources come from the cpg_* params in nextflow.config, all overridable from the params file:
      per-sample stages   one BAM each: fixed CPUs / memory / time; disk = sample base + storage per BAM
      cohort stages       a whole DROP group of n samples (reference size N = cpg_max_cohort_size):
                          CPUs, memory = max(floor, reference x n / N), from cpg_cohort_reference
                          disk = cohort base + per-sample storage x n, where the stages that take
                          every BAM count storage per BAM per sample

    Retries: a failed task is retried once, with 1.5x its resources (CPUs rounded down, so 1 stays 1).
    Upstream DROP doubles on retry; every resource below overrides that, including the label defaults.
----------------------------------------------------------------------------------------
*/

process {
    executor = 'google-batch'

    resourceLabels = [
        'ar-guid'         : params.arGuid ?: params.'ar-guid' ?: 'none',
        'dataset'         : params.dataset ?: 'none',
        'compute-category': 'nextflow',
    ]

    // Every task gets an exact N2 machine type that fits its CPUs and memory (T5.3). The Seqera compute
    // environment adds a process-level machineType list capped at 8 GB (e2-small, e2-medium, e2-standard-2);
    // a withName selector beats that. Cheapest N2 shape with >= the task's CPUs and memory >= its request
    // + max(2 GB, 10%) headroom, so the VM can hand the task what it asked for.
    withName: '.*' {
        machineType = {
            def cpus = task.cpus ?: 1
            double memoryGb = task.memory ? task.memory.toMega() / 1024.0d : 2.0d
            double needGb = memoryGb + Math.max(2.0d, memoryGb * 0.1d)
            // [name, vCPUs, GB] for every N2 shape; relative cost 0.04 per vCPU + 0.0054 per GB
            def shapes = [2, 4, 8, 16, 32, 48, 64, 80].collectMany { n ->
                [['highcpu', 1], ['standard', 4], ['highmem', 8]].collect { s -> ["n2-${s[0]}-${n}", n, n * s[1]] }
            }
            def fits = shapes.findAll { m -> m[1] >= cpus && m[2] >= needGb }
            fits ? fits.min { m -> m[1] * 0.04 + m[2] * 0.0054 }[0] : null
        }
    }

    // nf-core's retry codes, plus Google Batch's lost-VM codes: 50001 spot preemption that outlived
    // maxSpotAttempts, 50002 VM unresponsive (often memory exhaustion freezing the VM agent)
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175 + 50001 + 50002) ? 'retry' : 'finish' }
    maxRetries    = 1

    // stages not set below: base.config's defaults and labels, at 1.5x on retry instead of 2x
    cpus   = 1
    memory = { task.attempt > 1 ? '9 GB' : '6 GB' }
    time   = { task.attempt > 1 ? '6h' : '4h' }
    withLabel: 'process_single' {
        cpus   = 1
        memory = { task.attempt > 1 ? '9 GB' : '6 GB' }
        time   = { task.attempt > 1 ? '6h' : '4h' }
    }
    withLabel: 'process_low' {
        cpus   = { task.attempt > 1 ? 3 : 2 }
        memory = { task.attempt > 1 ? '18 GB' : '12 GB' }
        time   = { task.attempt > 1 ? '6h' : '4h' }
    }
    withLabel: 'process_medium' {
        cpus   = { task.attempt > 1 ? 9 : 6 }
        memory = { task.attempt > 1 ? '54 GB' : '36 GB' }
        time   = { task.attempt > 1 ? '12h' : '8h' }
    }
    withLabel: 'process_high' {
        cpus   = { task.attempt > 1 ? 18 : 12 }
        memory = { task.attempt > 1 ? '108 GB' : '72 GB' }
        time   = { task.attempt > 1 ? '24h' : '16h' }
    }
    // conf/modules.config sets this by name, which beats the labels above
    withName: 'DROP.*PREPROCESSGENEANNOTATION' {
        cpus   = { task.attempt > 1 ? 3 : 2 }
        memory = { task.attempt > 1 ? '15 GB' : '10 GB' }
        time   = { task.attempt > 1 ? '2h' : '1h' }
    }

    // per-sample stages: each reads (or writes) one sample's BAM
    withName: 'DROP.*SAMTOOLS_CONVERT.*|DROP.*SAMTOOLS_INDEX|DROP.*SAMTOOLS_IDXSTATS|DROP.*SPLICECOUNTS_COUNTNONSPLITREADS' {
        cpus   = { def f = task.attempt > 1 ? 1.5 : 1; Math.max(params.cpg_sample_cpus, Math.floor(params.cpg_sample_cpus * f) as int) }
        memory = { def f = task.attempt > 1 ? 1.5 : 1; "${Math.ceil(params.cpg_sample_memory_gb * f) as int} GB" }
        time   = { def f = task.attempt > 1 ? 1.5 : 1; "${Math.ceil(params.cpg_sample_time_h * f) as int}h" }
        disk   = { def f = task.attempt > 1 ? 1.5 : 1; "${Math.ceil((params.cpg_sample_disk_base_gb + params.cpg_storage_per_bam_gb) * f) as int} GB" }
    }

    // split-read counting: FRASER forks one worker per CPU (one chromosome each). An OOM-killed worker leaves
    // the parent R alive, which exits 1 ("wrong args for environment subassignment"), so retry on 1 as well,
    // twice, compounding 1.5x per attempt. CPUs stay fixed: more CPUs means more workers, not more memory per worker.
    withName: 'DROP.*SPLICECOUNTS_COUNTSPLITREADS' {
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 175 + 50001 + 50002 + 1) ? 'retry' : 'finish' }
        maxRetries    = 2
        cpus   = { params.cpg_sample_cpus }
        memory = { def f = Math.pow(1.5, task.attempt - 1); "${Math.ceil(params.cpg_sample_memory_gb * f) as int} GB" }
        time   = { def f = Math.pow(1.5, task.attempt - 1); "${Math.ceil(params.cpg_sample_time_h * f) as int}h" }
        disk   = { def f = Math.pow(1.5, task.attempt - 1); "${Math.ceil((params.cpg_sample_disk_base_gb + params.cpg_storage_per_bam_gb) * f) as int} GB" }
    }

    // gene counting: one worker per CPU (countReads.R), each holding a whole chromosome's alignments,
    // so it gets its own CPUs, generous memory and a longer time limit; disk as the other per-sample stages (T5.6)
    withName: 'DROP.*GENECOUNTS_COUNTREADS' {
        cpus   = { def f = task.attempt > 1 ? 1.5 : 1; Math.max(params.cpg_genecounts_cpus, Math.floor(params.cpg_genecounts_cpus * f) as int) }
        memory = { def f = task.attempt > 1 ? 1.5 : 1; "${Math.ceil(params.cpg_genecounts_memory_gb * f) as int} GB" }
        time   = { def f = task.attempt > 1 ? 1.5 : 1; "${Math.ceil(params.cpg_genecounts_time_h * f) as int}h" }
        disk   = { def f = task.attempt > 1 ? 1.5 : 1; "${Math.ceil((params.cpg_sample_disk_base_gb + params.cpg_storage_per_bam_gb) * f) as int} GB" }
    }

    // BAM-counting stages copy their inputs into local scratch instead of symlinking them to the Cloud
    // Storage FUSE mount: they do random-access reads per chromosome (FRASER from several forked workers),
    // which fail over FUSE. cpg-flow-rdrnaseq localises BAMs the same way (T5.5)
    withName: 'DROP.*GENECOUNTS_COUNTREADS|DROP.*SPLICECOUNTS_COUNTSPLITREADS|DROP.*SPLICECOUNTS_COUNTNONSPLITREADS' {
        stageInMode = 'copy'
    }

    // cohort stages: one task per DROP group. Everything scales with the group's sample count: splicing
    // stages carry meta.group_size, expression stages meta.ids. No fallback: a stage without either fails.
    // CPUs and memory scale linearly from the stage's cpg_cohort_reference entry, its size at
    // cpg_max_cohort_size samples, and never drop below the floors (or the reference, if that is lower)
    withName: 'DROP.*GENECOUNTS_(MERGECOUNTS|EXPORTCOUNTS|TPM|FILTERCOUNTS|SUMMARY)|DROP.*OUTRIDER_.*|DROP.*SPLICECOUNTS_(INIT|MERGESPLITREADS|MERGENONSPLITREADS|COLLECTCOUNTS|EXPORTCOUNTS|SUMMARY)|DROP.*FRASER_.*' {
        cpus   = {
            def f = task.attempt > 1 ? 1.5 : 1
            def samples = meta.group_size ?: (meta.ids instanceof List ? meta.ids.size() : 0)
            if (!samples) { throw new IllegalStateException("${task.process}: no DROP group size in meta (group_size / ids)") }
            def reference = params.cpg_cohort_reference[task.process.tokenize(':')[-1]][0]
            def scaled = Math.ceil(reference * samples / params.cpg_max_cohort_size) as int
            def cpus = Math.max(Math.min(params.cpg_cohort_cpus_floor, reference), scaled)
            Math.max(cpus, Math.floor(cpus * f) as int)
        }
        memory = {
            def f = task.attempt > 1 ? 1.5 : 1
            def samples = meta.group_size ?: (meta.ids instanceof List ? meta.ids.size() : 0)
            if (!samples) { throw new IllegalStateException("${task.process}: no DROP group size in meta (group_size / ids)") }
            def reference = params.cpg_cohort_reference[task.process.tokenize(':')[-1]][1]
            def scaled = Math.ceil(reference * samples / params.cpg_max_cohort_size) as int
            "${Math.ceil(Math.max(Math.min(params.cpg_cohort_memory_floor_gb, reference), scaled) * f) as int} GB"
        }
        time   = { def f = task.attempt > 1 ? 1.5 : 1; "${Math.ceil(params.cpg_cohort_time_h * f) as int}h" }
        disk   = {
            def f = task.attempt > 1 ? 1.5 : 1
            def samples = meta.group_size ?: (meta.ids instanceof List ? meta.ids.size() : 0)
            if (!samples) { throw new IllegalStateException("${task.process}: no DROP group size in meta (group_size / ids)") }
            "${Math.ceil((params.cpg_cohort_disk_base_gb + params.cpg_cohort_storage_per_sample_gb * samples) * f) as int} GB"
        }
    }

    // cohort stages that take every BAM in the group: storage per BAM, summed over the BAMs this task gets
    withName: 'DROP.*SPLICECOUNTS_MERGESPLITREADS|DROP.*SPLICECOUNTS_MERGENONSPLITREADS' {
        disk   = {
            def f = task.attempt > 1 ? 1.5 : 1
            "${Math.ceil((params.cpg_cohort_disk_base_gb + params.cpg_storage_per_bam_gb * (bams instanceof List ? bams.size() : 1)) * f) as int} GB"
        }
    }
}

// FRASER keeps its datasets in HDF5 (rhdf5), which locks files on open. Tasks run on the Cloud Storage
// FUSE mount, which has no locks, and storage differs between workers and VMs, so a lock means nothing
// here; each task writes only its own HDF5 files (T5.4)
env {
    HDF5_USE_FILE_LOCKING = 'FALSE'
}

google {
    location = 'australia-southeast1'
    batch.spot = true
    batch.maxSpotAttempts = 3
}