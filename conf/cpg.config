/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    CPG: Google Batch, as launched by analysis-runner through Seqera
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included at the end of nextflow.config whenever params.arGuid is set, i.e. every
    analysis-runner launch, and after conf/modules.config so the resources here win.
    The launcher supplies -work-dir and google.project. See docs/CPG_METAMIST_SEQR_DESIGN.md (T5.1).

    Resources come from the cpg_* params in nextflow.config:
      per-sample stages   one BAM each: disk = sample base + storage per BAM
      cohort stages       a whole DROP group: disk = cohort base + per-sample storage x samples,
                          where the stages that take every BAM count storage per BAM per sample
    Every value is multiplied by task.attempt, so a retry gets double.
----------------------------------------------------------------------------------------
*/

process {
    executor = 'google-batch'

    resourceLabels = [
        'ar-guid'         : params.arGuid ?: params.'ar-guid' ?: 'none',
        'dataset'         : params.dataset ?: 'none',
        'compute-category': 'nextflow',
    ]

    // nf-core's retry codes, plus Google Batch's lost-VM codes: 50001 spot preemption that outlived
    // maxSpotAttempts, 50002 VM unresponsive (often memory exhaustion freezing the VM agent)
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175 + 50001 + 50002) ? 'retry' : 'finish' }
    maxRetries    = 2

    // per-sample stages: each reads (or writes) one sample's BAM
    withName: 'DROP.*SAMTOOLS_CONVERT.*|DROP.*SAMTOOLS_INDEX|DROP.*SAMTOOLS_IDXSTATS|DROP.*GENECOUNTS_COUNTREADS|DROP.*SPLICECOUNTS_COUNTSPLITREADS|DROP.*SPLICECOUNTS_COUNTNONSPLITREADS' {
        cpus   = { params.cpg_sample_cpus * task.attempt }
        memory = { "${params.cpg_sample_memory_gb * task.attempt} GB" }
        time   = { "${params.cpg_sample_time_h * task.attempt}h" }
        disk   = { "${(params.cpg_sample_disk_base_gb + params.cpg_storage_per_bam_gb) * task.attempt} GB" }
    }

    // cohort stages working on counts, models and results. CPUs and memory stay as in conf/modules.config,
    // which DROP sizes for real cohorts. Disk scales with the samples in the task's DROP group: splicing
    // stages carry meta.group_size, expression stages meta.ids; cpg_max_cohort_size if neither is there
    withName: 'DROP.*GENECOUNTS_(MERGECOUNTS|EXPORTCOUNTS|TPM|FILTERCOUNTS|SUMMARY)|DROP.*OUTRIDER_.*|DROP.*SPLICECOUNTS_(INIT|COLLECTCOUNTS|EXPORTCOUNTS|SUMMARY)|DROP.*FRASER_.*' {
        time   = { "${params.cpg_cohort_time_h * task.attempt}h" }
        disk   = {
            def samples = meta.group_size ?: (meta.ids instanceof List ? meta.ids.size() : 0) ?: params.cpg_max_cohort_size
            "${(params.cpg_cohort_disk_base_gb + params.cpg_cohort_storage_per_sample_gb * samples) * task.attempt} GB"
        }
    }

    // cohort stages that take every BAM in the group: storage per BAM, summed over the BAMs this task gets
    withName: 'DROP.*SPLICECOUNTS_MERGESPLITREADS|DROP.*SPLICECOUNTS_MERGENONSPLITREADS' {
        time   = { "${params.cpg_cohort_time_h * task.attempt}h" }
        disk   = { "${(params.cpg_cohort_disk_base_gb + params.cpg_storage_per_bam_gb * (bams instanceof List ? bams.size() : 1)) * task.attempt} GB" }
    }
}

google {
    location = 'australia-southeast1'
    batch.spot = true
    batch.maxSpotAttempts = 3
}