/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    CPG: Google Batch, as launched by analysis-runner through Seqera
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Loaded by the `standard` profile, which Nextflow applies when no -profile is given.
    analysis-runner can't select profiles, so this is what every launch gets; local runs
    pass -profile (e.g. test,docker) and never see it. The launcher supplies -work-dir and
    google.project. See docs/CPG_METAMIST_SEQR_DESIGN.md (T5.1).
----------------------------------------------------------------------------------------
*/

process {
    executor = 'google-batch'

    resourceLabels = [
        'ar-guid'         : params.arGuid ?: 'none',
        'dataset'         : params.dataset ?: 'none',
        'compute-category': 'nextflow',
    ]

    // CRAM->BAM conversion and the counting steps hold a full BAM (plus its CRAM) on local disk
    withName: '.*SAMTOOLS_CONVERT.*|.*SAMTOOLS_INDEX|.*SAMTOOLS_IDXSTATS|.*GENECOUNTS_COUNTREADS|.*SPLICECOUNTS_COUNT.*' {
        disk = { 100.GB * task.attempt }
    }
}

google {
    location = 'australia-southeast1'
    batch.spot = true
    batch.maxSpotAttempts = 3
}